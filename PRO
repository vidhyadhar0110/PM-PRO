FROM ((((pressganey_db.vw_patient_demographics_vs vpd
LEFT JOIN clinical_db.surgical_case sc ON (((sc.encntr_id = vpd.encntr_id) AND (sc.person_id = vpd.person_id))))
LEFT JOIN patient_cds.dim_patient_info_option dpio ON (((dpio.person_id = vpd.person_id) AND (lower((dpio.info_sub_description)::text) ~ ('%survey%'::character varying)::text))))
LEFT JOIN provider_cds.dim_provider dp ON ((((dp.provider_person_id)::character varying)::text = (sc.anesth_prsnl_id)::text)))
LEFT JOIN clinical_cds.fact_encounter fc ON (((fc.encntr_id = vpd.encntr_id) AND (fc.attend_physician_id = dp.provider_person_id)))
left join provider_cds.dim_provider dp1 ON dp1.provider_person_id = vpd.attend_physician_id
left join mars_db.dim_provider mdp ON mdp.npinumber = dp1.provider_npi)
left join cerner_cpt_driver ccd ON ccd.encntr_id = vpd.encntr_id
WHERE (((vpd.encntr_type_cd = 309311) OR (vpd.encntr_type_cd = 309309)) OR (vpd.encntr_type_cd = 195302052)) with no schema binding;
