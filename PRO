(SELECT cc.procedure_code FROM cerner_cpt cc WHERE (cc.encntr_id = vpd.encntr_id AND cc.rn = 3)) AS procedure_code_3,
(SELECT cc.procedure_code FROM cerner_cpt cc WHERE (cc.encntr_id = vpd.encntr_id AND cc.rn = 4)) AS procedure_code_4,
