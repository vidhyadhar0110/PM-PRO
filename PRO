(SELECT cc.procedure_code FROM cerner_cpt cc WHERE (cc.encntr_id = vpd.encntr_id AND cc.rn = 6)) AS procedure_code_6,
COALESCE(dpio.value_description, 'N'::character varying) AS no_publicity_flag, CASE WHEN (vpd.deceased = ('Yes'::character varying)::text) THEN 'Y'::character varying ELSE 'N'::character varying END AS deceased_flag, CASE WHEN ((((((((((fc.disch_disposition_cd = 18738276) OR (fc.disch_disposition_cd = 312906)) OR (fc.disch_disposition_cd = 685144)) OR (fc.disch_disposition_cd = 732363177)) OR (fc.disch_disposition_cd = 638677)) OR (fc.disch_disposition_cd = 4510195)) OR (fc.disch_disposition_cd = 732363263)) OR (fc.disch_disposition_cd = 4190898)) OR (fc.disch_disposition_cd = 4225260)) OR (fc.disch_disposition_cd = 732363557)) THEN 'Y'::character varying ELSE 'N'::character varying END AS "transferred/admitted_to_inpatient", vpd.admitted_to_inpatient_fl AS transferred_admitted_to_inpatient, dp.provider_npi AS anesthesiologist_npi, sc.primary_anesthesiologist AS anesthesiologist_name, sc.surg_case_id AS case_number, dp1.provider_specialty AS att_provider_specialty, sc.surg_or_location AS or_location, sc.primary_surgeon AS surgeon_name, sc.primary_surgeon_id AS surgeon_npi, vpd.religion,coalesce(mdp.homedepartment:: TEXT, '') AS att_provider_dept,
    coalesce(mdp.homedivision:: TEXT, '') AS att_provider_division, '$'::character varying AS eor_indicator, sc.surg_start_dt_tm,
